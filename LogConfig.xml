<?xml version="1.0" encoding="utf-8" ?>
<log4net>
	<appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
		<file type="log4net.Util.PatternString" value="%property{LogFileName}"></file>
		<!-- 推荐使用 MinimalLock 避免文件锁冲突 -->
		<lockingModel type="log4net.Appender.FileAppender+MinimalLock"></lockingModel>
		<!-- 每次启动不清空 -->
		<appendToFile value="true"></appendToFile>

		<!-- 滚动策略：按日期 -->
		<rollingStyle value="Date" />
		<datePattern value="yyyy-MM-dd'.log'" />
		<staticLogFileName value="false" />

		<!-- 日志格式 -->
		<layout type="log4net.Layout.PatternLayout">
			<param name="ConversionPattern" value="%d[%-5level] %message%newline" />
		</layout>
	</appender>
	<logger name="logger" additivity="false">
		<level value="ALL"></level>
		<appender-ref ref="RollingFileAppender"></appender-ref>
	</logger>
</log4net>
